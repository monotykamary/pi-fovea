{
  "name": "pi-fovea",
  "version": "0.29.2",
  "description": "Token-budgeted repo mapping for agent sessions: foveated heat diffusion over a cross-language code graph, with progressive disclosure.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "monotykamary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-fovea.git"
  },
  "homepage": "https://github.com/monotykamary/pi-fovea#readme",
  "bugs": "https://github.com/monotykamary/pi-fovea/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "repo-map",
    "code-graph",
    "heat-diffusion",
    "progressive-disclosure",
    "context-engineering",
    "agents"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/monotykamary/pi-fovea/main/media/cover.svg"
  },
  "exports": {
    "./ops": "./src/core/ops.ts",
    "./substrate": "./src/substrate.ts",
    "./workspace": "./src/workspace.ts"
  },
  "files": [
    "src",
    "docs/substrate.md",
    "docs/workspace.md",
    "docs/proofs.md",
    "docs/licenses/bend-apache-2.0.txt",
    "THIRD_PARTY_NOTICES.md",
    "LAWS.bend",
    "PROOF.bend",
    "proofs",
    "scripts/check-proofs.mjs",
    "scripts/compile-bend.mjs",
    "cli.ts",
    "dist",
    "skills",
    "media",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "fovea": "dist/cli.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bench": "tsx scripts/bench.ts",
    "corpus:coverage": "bun scripts/coverage-corpus.mjs",
    "corpus:performance": "bun scripts/performance-corpus.mjs",
    "build:cli": "bun run proofs:artifact && tsx scripts/build-cli.ts",
    "prepack": "bun run check:proofs && bun run build:cli",
    "check:package": "node scripts/check-package.mjs",
    "fovea": "tsx cli.ts",
    "lint:dead": "knip",
    "check:proofs": "node scripts/check-proofs.mjs",
    "proofs:generate": "node scripts/check-proofs.mjs --write",
    "proofs:artifact": "node scripts/check-proofs.mjs --artifact",
    "check:fast": "bun run check:proofs && bun run typecheck && bun run test:changed",
    "test:changed": "node scripts/test-affected.mjs",
    "test:affected": "node scripts/test-affected.mjs --base $PI_TEST_BASE",
    "test:related": "vitest related",
    "test:smoke": "vitest run tests/verified-kernels.test.ts tests/startup.test.ts tests/config.test.ts tests/settings.test.ts tests/substrate.test.ts tests/scan.test.ts tests/extract.test.ts tests/join.test.ts tests/heat.test.ts tests/nuclei.test.ts tests/render.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "knip": "^6.32.0",
    "tsx": "^4.19.0",
    "typebox": "^1.3.10",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@ast-grep/cli": "^0.45.3"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "workspaces": [
    "."
  ]
}
